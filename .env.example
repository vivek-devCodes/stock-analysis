# ── Admin login (single user, no database) ─────────────────────────────────
# Generate all three secrets with:  npm run hash-password -- "your-strong-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# Signs the JWT session cookie. Changing it signs everyone out.
AUTH_SECRET=<random-48-bytes>
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=<random-32-bytes>

# LLM Recommendation System (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Daily Email Dispatch Configuration (8:45 AM IST)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
REPORT_RECIPIENTS=your_email@gmail.com,another_trader@domain.com

# Watchlist for the scheduled email (comma-separated Yahoo tickers).
# Copy it from the dashboard: Daily AI Report → "Your watchlist in the email".
WATCHLIST_SYMBOLS=RELIANCE.NS,TCS.NS,INFY.NS

# Optional Market APIs (App works without keys via Yahoo Finance + NSE/BSE direct feeds)
FINNHUB_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
