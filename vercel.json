{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/morning-report",
      "schedule": "0 3 * * 1-5"
    },
    {
      "path": "/api/cron/agent-scan?session=postmarket",
      "schedule": "45 10 * * 1-5"
    },
    {
      "path": "/api/cron/paper-trade",
      "schedule": "5 4 * * 1-5"
    },
    {
      "path": "/api/cron/nightly",
      "schedule": "45 13 * * 1-5"
    }
  ]
}
